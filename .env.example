# Copie para .env (já está no .gitignore).

# O assistente de IA roda em cima da assinatura do Claude Code (CLI `claude -p`) já logada na
# máquina - sem chave de API. Ver histórico e detalhes em app/llm_client.py.

# Só precisa setar se o binário `claude` não estiver no PATH do processo do backend -
# aponte pro caminho completo.
CLAUDE_CLI_COMMAND=claude
# Timeout em segundos pra cada chamada do `claude -p` (padrão 60).
CLAUDE_CLI_TIMEOUT=60
